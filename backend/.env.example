# Copy this file to backend/.env and put your own key after the "=".
# Never commit backend/.env (it must be listed in .gitignore).
GOOGLE_API_KEY=

# Optional settings
# GEMINI_MODEL=gemini-3.1-flash-lite
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# MAX_UPLOAD_MB=20
# Comma-separated list of frontend origins allowed to call the API (default: all)
# ALLOWED_ORIGINS=http://localhost:5173
